{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weathership-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
  // Custom domain weathership.zndx.org is bound in the Cloudflare dashboard
  // because the deploy token lacks zone:route permissions (matches gaius pattern).
  // See docs/current/src/operations/dns.md.
}
