---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const nautilus = (await getCollection("projects")).find((p) => p.id === "nautilus");
const projects = (await getCollection("projects"))
  .filter((p) => p.data.status === "active" && p.id !== "nautilus" && p.id !== "sdg-strategy" && p.id !== "kvasir")
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
const projectMap = new Map(
  (await getCollection("projects")).map((p) => [p.id, p])
);
const methods = (await getCollection("methods"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const news = (await getCollection("news"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Base>
  <section class="hero">
    <p class="hero__eyebrow">Open source enterprise AI</p>
    <h1 class="hero__title">weathership</h1>
    <p class="hero__lede">
      Signals is the foundation: a federated protocol, scheduler, and
      warehouse that independent engines attach to. Gaius, Ægir,
      Atelier, and
      <a href="https://hermes-agent.nousresearch.com/" rel="external">Hermes</a>
      (by <a href="https://nousresearch.com/" rel="external">Nous Research</a>)
      coordinate over gRPC to autonomously maintain
      federated data products. They meet on the lattice — workloads in
      YuniKorn, Airflow, and Metaflow; data in Kudu and Iceberg.
    </p>
    <div class="hero__cta">
      <a class="button" href="/projects/">Projects</a>
      <a class="button button--ghost" href="/about">About</a>
    </div>
  </section>

  {nautilus && (
    <section class="nautilus-band" aria-labelledby="nautilus-heading">
      <div class="nautilus-band__inner">
        <p class="nautilus-band__eyebrow">Supervision</p>
        <div class="nautilus-band__grid">
          <div>
            <h2 id="nautilus-heading">{nautilus.data.name}</h2>
            <p class="nautilus-band__lede">{nautilus.data.tagline}</p>
            <p class="nautilus-band__body">{nautilus.data.summary}</p>
            <div class="nautilus-band__cta">
              <a class="button" href={`/projects/${nautilus.id}/`}>Overview</a>
              {nautilus.data.repo && (
                <a class="button button--ghost nautilus-band__ghost" href={nautilus.data.repo}>GitHub</a>
              )}
            </div>
          </div>
          <ul class="nautilus-band__points">
            <li>
              <strong>Agent-free.</strong> Triggers are a pure function of
              a snapshot. Judgment stays in the engine as Overwatch.
            </li>
            <li>
              <strong>One instance per project.</strong> The protocol is
              the grammar; each engine ships a textproto tree.
            </li>
            <li>
              <strong>Scored, then promoted.</strong> Recycles, floors, and
              escalations are forecasts on a Brier ledger — actuation
              earns its keep.
            </li>
          </ul>
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <header class="section__head">
      <h2>Projects</h2>
      <a class="section__link" href="/projects/">All projects</a>
    </header>
    <div class="proj-grid">
      {projects.map((p) => (
        <a class={`proj-card proj-card--${p.data.visibility}`} href={`/projects/${p.id}/`}>
          <div class="proj-card__head">
            <h3>{p.data.name}</h3>
            <span class={`tag tag--${p.data.status === 'active' ? 'accent' : p.data.status}`}>{p.data.status}</span>
          </div>
          <p>{p.data.tagline}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <header class="section__head">
      <h2>Methods</h2>
      <a class="section__link" href="/methods/">All methods</a>
    </header>
    <div class="meth-grid">
      {methods.map((m) => {
        const linked = m.data.projects
          .map((slug) => projectMap.get(slug))
          .filter(Boolean);
        return (
          <a class="meth-card" href={`/methods/${m.id}/`}>
            <h3>{m.data.name}</h3>
            <p>{m.data.tagline}</p>
            <div class="meth-card__projects">
              {linked.map((p, i) => (
                <>
                  {i > 0 && <span class="meth-card__sep">·</span>}
                  <span>{p.data.name}</span>
                </>
              ))}
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <section class="section">
    <header class="section__head">
      <h2>Latest</h2>
      <a class="section__link" href="/news/">All news</a>
    </header>
    <ul class="news-list">
      {news.map((n) => (
        <li>
          <a href={`/news/${n.id}/`}>
            <span class="news-list__date">{n.data.date.toISOString().slice(0, 10)}</span>
            <span class="news-list__title">{n.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <style>
    .hero {
      padding: 24px 0 32px;
      max-width: 760px;
    }
    .hero__eyebrow {
      margin: 0 0 14px;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ws-storm);
    }
    .hero__title {
      margin: 0;
      font-size: clamp(56px, 9vw, 96px);
      letter-spacing: -0.03em;
      line-height: 1;
      color: var(--ws-ink);
      font-weight: 600;
    }
    .hero__lede {
      margin: 32px 0;
      font-size: 19px;
      color: var(--ws-storm);
      max-width: 60ch;
    }
    .hero__cta { display: flex; gap: 12px; flex-wrap: wrap; }

    .nautilus-band {
      position: relative;
      left: 50%;
      width: 100vw;
      margin-left: -50vw;
      margin-top: 72px;
      background: var(--ws-ink);
      color: var(--ws-paper);
      padding: 64px 0;
    }
    .nautilus-band__inner {
      max-width: var(--ws-shell-max);
      margin: 0 auto;
      padding: 0 var(--ws-shell-pad);
    }
    .nautilus-band__eyebrow {
      margin: 0 0 12px;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ws-fog);
    }
    .nautilus-band__grid {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 48px;
      align-items: start;
    }
    .nautilus-band h2 {
      margin: 0 0 12px;
      font-size: clamp(32px, 4vw, 44px);
      color: var(--ws-paper);
    }
    .nautilus-band__lede {
      margin: 0 0 16px;
      font-size: 19px;
      color: var(--ws-fog);
    }
    .nautilus-band__body {
      margin: 0 0 28px;
      font-size: 16px;
      color: color-mix(in oklab, var(--ws-paper) 82%, var(--ws-storm));
      max-width: 58ch;
    }
    .nautilus-band__cta { display: flex; gap: 12px; flex-wrap: wrap; }
    .nautilus-band__ghost {
      color: var(--ws-paper);
      border-color: color-mix(in oklab, var(--ws-paper) 28%, transparent);
    }
    .nautilus-band__ghost:hover {
      background: color-mix(in oklab, var(--ws-paper) 10%, transparent);
    }
    .nautilus-band__points {
      list-style: none;
      margin: 8px 0 0;
      padding: 0;
      display: grid;
      gap: 18px;
    }
    .nautilus-band__points li {
      padding-top: 16px;
      border-top: 1px solid color-mix(in oklab, var(--ws-paper) 14%, transparent);
      font-size: 15px;
      color: color-mix(in oklab, var(--ws-paper) 82%, var(--ws-storm));
    }
    .nautilus-band__points strong {
      display: block;
      color: var(--ws-paper);
      font-weight: 600;
      margin-bottom: 4px;
    }

    .section { margin-top: 72px; }
    .section__head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 20px;
    }
    .section__head h2 { margin: 0; }
    .section__link { font-size: 14px; }

    .proj-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .proj-card {
      display: block;
      padding: 20px;
      border: 1px solid var(--ws-fog);
      border-radius: var(--ws-radius-md);
      background: var(--ws-paper);
      color: inherit;
      text-decoration: none;
      transition: border-color 120ms ease, transform 120ms ease;
    }
    .proj-card:hover {
      border-color: color-mix(in oklab, var(--ws-fog) 40%, var(--ws-storm));
      transform: translateY(-1px);
    }
    .proj-card--stealth {
      background: color-mix(in oklab, var(--ws-ink) 96%, var(--ws-storm));
      color: var(--ws-paper);
      border-color: var(--ws-storm);
    }
    .proj-card--stealth:hover {
      border-color: var(--ws-fog);
    }
    .proj-card__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
    }
    .proj-card h3 { margin: 0; font-size: 17px; }
    .proj-card p { margin: 0; font-size: 14px; color: inherit; opacity: 0.85; }

    .meth-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .meth-card {
      display: block;
      padding: 20px;
      border: 1px solid var(--ws-fog);
      border-radius: var(--ws-radius-md);
      background: var(--ws-paper);
      color: inherit;
      text-decoration: none;
      transition: border-color 120ms ease, transform 120ms ease;
    }
    .meth-card:hover {
      border-color: color-mix(in oklab, var(--ws-fog) 40%, var(--ws-storm));
      transform: translateY(-1px);
    }
    .meth-card h3 { margin: 0 0 6px; font-size: 17px; }
    .meth-card p { margin: 0 0 12px; font-size: 14px; opacity: 0.85; }
    .meth-card__projects {
      font-family: var(--ws-font-mono);
      font-size: 12px;
      color: var(--ws-storm);
      letter-spacing: 0.02em;
    }
    .meth-card__sep { opacity: 0.5; margin: 0 6px; }

    .news-list { list-style: none; margin: 0; padding: 0; }
    .news-list li { border-top: 1px solid var(--ws-fog); }
    .news-list li:last-child { border-bottom: 1px solid var(--ws-fog); }
    .news-list a {
      display: grid;
      grid-template-columns: 120px 1fr;
      gap: 16px;
      padding: 14px 0;
      color: inherit;
      text-decoration: none;
    }
    .news-list a:hover .news-list__title { color: var(--ws-sea); }
    .news-list__date { color: var(--ws-storm); font-family: var(--ws-font-mono); font-size: 13px; }
    .news-list__title { font-weight: 500; }

    @media (max-width: 720px) {
      .proj-grid { grid-template-columns: 1fr; }
      .meth-grid { grid-template-columns: 1fr; }
      .news-list a { grid-template-columns: 1fr; gap: 4px; }
      .nautilus-band__grid { grid-template-columns: 1fr; gap: 28px; }
    }
  </style>
</Base>
