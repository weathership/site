---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---
<Base title="Projects" description="weathership's open-source projects span enterprise data governance, graph-oriented exploration, distributed manufacturing, and a global compute fabric.">
  <header class="proj-header">
    <p class="eyebrow">Projects</p>
    <h1>Different systems, same shape.</h1>
    <p class="lede">
      Each project reads the conditions of a different system —
      relational data, graph-oriented data, manufacturing telemetry,
      and the compute fabric that federates them — and turns that
      reading into structured signal.
    </p>
  </header>

  <ul class="proj-list">
    {projects.map((p) => (
      <li class={`proj-row proj-row--${p.data.visibility}`}>
        <a href={`/projects/${p.id}/`}>
          <header>
            <h2>{p.data.name}</h2>
            <span class={`tag tag--${p.data.status === 'active' ? 'accent' : p.data.status}`}>{p.data.status}</span>
          </header>
          <p class="proj-row__tagline">{p.data.tagline}</p>
          <p class="proj-row__summary">{p.data.summary}</p>
          <div class="proj-row__links">
            {p.data.repo && <span class="link">github →</span>}
            {p.data.docs && <span class="link">docs →</span>}
            {!p.data.repo && !p.data.docs && p.data.visibility === 'stealth' && <span class="link">in stealth — contact for details</span>}
          </div>
        </a>
      </li>
    ))}
  </ul>

  <style>
    .proj-header { max-width: 70ch; margin-bottom: 56px; }
    .eyebrow {
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ws-storm);
      margin: 0 0 12px;
    }
    .lede { font-size: 19px; color: var(--ws-storm); }

    .proj-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
    .proj-row a {
      display: block;
      padding: 28px;
      border: 1px solid var(--ws-fog);
      border-radius: var(--ws-radius-md);
      background: var(--ws-paper);
      color: inherit;
      text-decoration: none;
      transition: border-color 120ms ease;
    }
    .proj-row a:hover {
      border-color: color-mix(in oklab, var(--ws-fog) 40%, var(--ws-storm));
    }
    .proj-row--stealth a {
      background: color-mix(in oklab, var(--ws-ink) 96%, var(--ws-storm));
      color: var(--ws-paper);
      border-color: var(--ws-storm);
    }
    .proj-row--stealth a:hover { border-color: var(--ws-fog); }

    .proj-row header {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 8px;
    }
    .proj-row h2 { margin: 0; font-size: 22px; }
    .proj-row__tagline { margin: 0 0 6px; font-weight: 500; }
    .proj-row__summary { margin: 0 0 12px; opacity: 0.85; max-width: 70ch; }
    .proj-row__links { display: flex; gap: 16px; font-size: 14px; color: var(--ws-storm); }
    .proj-row--stealth .proj-row__links { color: var(--ws-fog); }
    .link { font-family: var(--ws-font-mono); font-size: 13px; }
  </style>
</Base>
