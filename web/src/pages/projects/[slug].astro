---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<Base title={project.data.name} description={project.data.summary}>
  <article class={`proj proj--${project.data.visibility}`}>
    <header>
      <p class="eyebrow"><a href="/projects/">Projects</a></p>
      <div class="proj__head">
        <h1>{project.data.name}</h1>
        <span class={`tag tag--${project.data.status === 'stealth' ? 'stealth' : project.data.status === 'active' ? 'accent' : ''}`}>{project.data.status}</span>
      </div>
      <p class="proj__tagline">{project.data.tagline}</p>
      <div class="proj__links">
        {project.data.repo && <a href={project.data.repo}>repository →</a>}
        {project.data.docs && <a href={project.data.docs}>documentation →</a>}
      </div>
    </header>
    <div class="proj__body">
      <Content />
    </div>
  </article>
  <style>
    .proj { max-width: 70ch; }
    .eyebrow {
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ws-storm);
      margin: 0 0 12px;
    }
    .eyebrow a { color: inherit; }
    .proj__head { display: flex; align-items: center; gap: 16px; margin-top: 0; }
    .proj__head h1 { margin: 0; }
    .proj__tagline { font-size: 19px; color: var(--ws-storm); margin: 6px 0 16px; }
    .proj__links { display: flex; gap: 24px; margin-bottom: 32px; font-size: 14px; }
    .proj__body { font-size: 17px; line-height: 1.7; }
    .proj__body p { margin: 1.1em 0; }
    .proj__body ol { padding-left: 1.4em; }
    .proj__body ol li { margin-bottom: 0.6em; }
    .proj__body ul { padding-left: 1.4em; }
  </style>
</Base>
