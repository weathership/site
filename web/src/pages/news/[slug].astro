---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("news");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.summary}>
  <article class="post">
    <header>
      <p class="eyebrow"><a href="/news/">News</a></p>
      <h1>{post.data.title}</h1>
      <p class="post__meta">
        <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
        <span> · </span>
        <span>{post.data.author}</span>
      </p>
    </header>
    <div class="post__body">
      <Content />
    </div>
  </article>
  <style>
    .post { max-width: 70ch; }
    .eyebrow {
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ws-storm);
      margin: 0 0 12px;
    }
    .eyebrow a { color: inherit; }
    .post h1 { margin-top: 0; }
    .post__meta {
      color: var(--ws-storm);
      font-family: var(--ws-font-mono);
      font-size: 13px;
      margin-bottom: 32px;
    }
    .post__body { font-size: 17px; line-height: 1.7; }
    .post__body p { margin: 1.1em 0; }
    .post__body em { font-style: italic; }
  </style>
</Base>
