---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("news"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="News" description="weathership news and releases.">
  <header class="news-header">
    <p class="eyebrow">News</p>
    <h1>News</h1>
    <p class="subscribe">
      Longer essays also appear on
      <a href="https://weathership.substack.com" rel="external">Substack</a>.
    </p>
  </header>

  <ul class="news-index">
    {posts.map((p) => (
      <li>
        <a href={`/news/${p.id}/`}>
          <time datetime={p.data.date.toISOString()}>{p.data.date.toISOString().slice(0, 10)}</time>
          <h2>{p.data.title}</h2>
          <p>{p.data.summary}</p>
        </a>
      </li>
    ))}
  </ul>

  <style>
    .news-header { max-width: 70ch; margin-bottom: 40px; }
    .subscribe { margin: 16px 0 0; color: var(--ws-storm); font-size: 16px; }
    .eyebrow {
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ws-storm);
      margin: 0 0 12px;
    }
    .news-index { list-style: none; margin: 0; padding: 0; }
    .news-index li {
      border-top: 1px solid var(--ws-fog);
    }
    .news-index li:last-child { border-bottom: 1px solid var(--ws-fog); }
    .news-index a {
      display: block;
      padding: 24px 0;
      color: inherit;
      text-decoration: none;
    }
    .news-index a:hover h2 { color: var(--ws-sea); }
    .news-index time {
      font-family: var(--ws-font-mono);
      font-size: 13px;
      color: var(--ws-storm);
    }
    .news-index h2 {
      margin: 4px 0 6px;
      font-size: 22px;
    }
    .news-index p {
      margin: 0;
      color: var(--ws-storm);
      max-width: 70ch;
    }
  </style>
</Base>
